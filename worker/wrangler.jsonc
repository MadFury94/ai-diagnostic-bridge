{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-diagnostic-bridge",
  "account_id": "e260983617003d3a7092441acdfcd4f4",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "ai": { "binding": "AI" },
  "vars": { "ALLOWED_SITE_ORIGIN": "https://anbenigeria.com" },
  "secrets": { "required": ["DASHBOARD_PASSWORD", "CREDENTIAL_KEY", "SESSION_KEY"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "ai-diagnostic-bridge", "database_id": "231f8e19-7547-4b93-89b9-75cca8f0ab57", "migrations_dir": "migrations" }
  ],
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "92326001", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "92326002", "simple": { "limit": 60, "period": 60 } },
    { "name": "CONNECTION_LIMIT", "namespace_id": "92326003", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
